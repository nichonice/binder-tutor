rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil: alle kan læse, men du kan kun skrive din egen
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Wants: alle kan læse (så matching virker), du styrer kun dine egne
    match /wants/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Samlinger og matches skrives KUN af nightly-jobbet (Admin SDK går
    // udenom disse rules). Klienten må kun læse.
    match /collections/{uid} {
      allow read: if true;
      allow write: if false;
      match /chunks/{n} {
        allow read: if true;
        allow write: if false;
      }
    }
    match /matches/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
